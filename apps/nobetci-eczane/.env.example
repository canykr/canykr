# Nöbetçi eczane veri kaynağı yapılandırması.
# Bu dosyayı `.env` adıyla kopyalayıp değerleri doldurun.

# Hangi sağlayıcı kullanılacak: demo | collectapi | nosyapi | custom
# Tanımlanmazsa uygulama örnek (demo) veriyle açılır.
EXPO_PUBLIC_PHARMACY_PROVIDER=demo

# collectapi / nosyapi için API anahtarı.
# UYARI: EXPO_PUBLIC_ ile başlayan değişkenler uygulama paketine gömülür ve
# uygulamayı indiren herkes tarafından okunabilir. Yayına çıkarken anahtarı
# kendi sunucunuzda tutup `custom` sağlayıcısını kullanın.
EXPO_PUBLIC_PHARMACY_API_KEY=

# `custom` sağlayıcısı için kendi sunucunuzun (ya da vekil servisinizin) adresi.
# Beklenen uç nokta: GET {URL}/nobetci?il=Ankara&ilce=Çankaya
EXPO_PUBLIC_PHARMACY_API_URL=

# Eczane panelinden gelen kayıtların ve hata bildirimlerinin gönderileceği adres.
# Tanımlanmazsa kayıtlar yalnızca cihazda saklanır.
EXPO_PUBLIC_PHARMACY_SUBMIT_URL=

# Ağ isteklerinin zaman aşımı (milisaniye).
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=12000
